# Server
PORT=8000
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://carebridge.vercel.app
DEBUG=true

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carebridge
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Security
JWT_SECRET_KEY=super_secret_jwt_key_carebridge_hospitalos_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=900
